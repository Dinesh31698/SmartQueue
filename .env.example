# SmartQueue Root Environment Configuration Example

# Server Environment
NODE_ENV=development
PORT=5000
CLIENT_URL=http://localhost:5173

# MongoDB Database Configuration
MONGODB_URI=mongodb://127.0.0.1:27017/smartqueue
MONGODB_URI_TEST=mongodb://127.0.0.1:27017/smartqueue_test

# Authentication & Security
JWT_SECRET=smartqueue_super_secret_jwt_key_change_in_production_2026!
JWT_EXPIRES_IN=7d

# CORS Allowed Origins (comma separated)
CORS_ORIGIN=http://localhost:5173,http://localhost:3000

# Supermarket Defaults
DEFAULT_STORE_ID=STORE-001
DEFAULT_STORE_NAME=SmartQueue Supermarket Flagship

# Optional / Feature Integrations
ENABLE_SOCKET_IO=true
ENABLE_AI_RECOMMENDER=true
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100
